   "source": [
    "# 42 Find Duplicate Values in a List"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "8e746633-92d9-4352-acbb-322c733d1167",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Duplicates: {10, 20}\n"
     ]
    }
   ],
   "source": [
    "data = [10, 20, 30, 20, 40, 50, 10]\n",
    "\n",
    "seen = set()\n",
    "duplicates = set()\n",
    "\n",
    "for num in data:\n",
    "    if num in seen:\n",
    "        duplicates.add(num)\n",
    "    else:\n",
    "        seen.add(num)\n",
    "\n",
    "print(\"Duplicates:\", duplicates)"
   ]
  },
