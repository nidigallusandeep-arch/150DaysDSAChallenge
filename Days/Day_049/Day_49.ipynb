      "7\n"
     ]
    }
   ],
   "source": [
    "class Solution:\n",
    "    def kthsmallest(self,arr,k):\n",
    "        arr.sort()\n",
    "        return arr[k-1]\n",
    "arr=[7,10,4,3,20,15]\n",
    "k=3\n",
    "obj=Solution()\n",
    "print(obj.kthsmallest(arr,k))"
   ]
  }
