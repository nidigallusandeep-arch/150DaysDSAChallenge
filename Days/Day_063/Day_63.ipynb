   "source": [
    "# 93.Reverse a Stack"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "ce03fb5d-b2ea-44e1-affa-756566acd0f7",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[50, 40, 30, 20, 10]\n"
     ]
    }
   ],
   "source": [
    "class Solution:\n",
    "    def reverse_stack(stack):\n",
    "        temp=[]\n",
    "        while stack:\n",
    "            temp.append(stack.pop())\n",
    "        stack.extend(temp)\n",
    "        return stack\n",
    "stack=[10,20,30,40,50]\n",
    "obj=Solution\n",
    "print(obj.reverse_stack(stack))"
   ]
  }
 ],
