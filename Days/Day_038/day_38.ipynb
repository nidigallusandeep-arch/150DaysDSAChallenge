   "source": [
    "# 65.Print elements from both ends"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "d475ab9c-812d-498b-81b2-0cbc85a92712",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1 5\n",
      "2 4\n",
      "3 3\n"
     ]
    }
   ],
   "source": [
    "class Solution:\n",
    "    def two_pointer(self,arr):\n",
    "        left=0\n",
    "        right=len(arr)-1\n",
    "        while left<=right:\n",
    "            print(arr[left],arr[right])\n",
    "            left+=1\n",
    "            right-=1\n",
    "arr=[1,2,3,4,5]\n",
    "obj=Solution()\n",
    "obj.two_pointer(arr)"
   ]
  }
 ],
