   "source": [
    "# 87.Reverse a Number"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "11a64b1c-4217-4fb3-b541-87afce136483",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "7782\n"
     ]
    }
   ],
   "source": [
    "class Solution:\n",
    "    def reverse_number(self,n):\n",
    "        rev=0\n",
    "        while n>0:\n",
    "            digit=n%10\n",
    "            rev=rev*10+digit\n",
    "            n=n//10\n",
    "        return rev\n",
    "obj=Solution()\n",
    "print(obj.reverse_number(2877))"
   ]
  }
 ],
