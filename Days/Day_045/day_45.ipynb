   "source": [
    "# 76.Find the average of array elements."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "213a0599-df9d-41e1-b23c-94f4fabf73e1",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "45\n"
     ]
    }
   ],
   "source": [
    "class Solution:\n",
    "    def average(self,arr):\n",
    "        total=0\n",
    "        for i in arr:\n",
    "            total+=i\n",
    "        return total//len(arr)\n",
    "arr=[10,20,30,40,50,60,70,80]\n",
    "obj=Solution()\n",
    "print(obj.average(arr))"
   ]
  }
 ],
