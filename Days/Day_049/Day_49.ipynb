   "source": [
    "# 80 Kth smallest element\n",
    "- arr = [7, 10, 4, 3, 20, 15]\n",
    "- k = 3"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "51738124-3417-4e47-bd5b-ed009b9d5daf",
   "metadata": {},
